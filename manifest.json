{
    "manifest_version": 3,
    "name": "LLM Hallucination Detector",
    "version": "1.0.0",
    "description": "Chrome extension detecting LLM hallucinations in the response from LLM Models like ChatGPT, Claude, Gemini, etc.",
    "permissions": ["storage"],
    "action": {
      "default_popup": "index.html"
    },
    "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
    "content_scripts": [
      {
        "js": ["src/content.tsx"],
        "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"]
      }
    ]
  }